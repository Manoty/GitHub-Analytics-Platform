# ─── App ───────────────────────────────────────────
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
DEBUG=true

# ─── Database ──────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=github_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/github_analytics

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── GitHub OAuth ──────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# ─── GitHub API ────────────────────────────────────
GITHUB_API_BASE_URL=https://api.github.com

# ─── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GITHUB_CLIENT_ID=your_github_client_id

# ─── Celery ────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── DuckDB ────────────────────────────────────────
DUCKDB_PATH=/app/analytics/warehouse.duckdb